<!--
  Adaptive-icon foreground. 108dp canvas, mark constrained to the inner 66dp
  safe area (viewport coords 21..87) so no launcher mask (circle, squircle,
  teardrop, rounded-square) can crop it.

  Mark: document sheet with a folded top-right corner, a bold blue "name-bar"
  header, subtitle line and body strokes. Mirrors public/favicon.svg exactly so
  the identity is consistent from browser tab to home-screen icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Document body. 44 wide × 60 tall, centred inside the safe area. -->
    <path
        android:pathData="M32,24 L68,24 Q74,24 74,30 L74,80 Q74,84 70,84 L36,84 Q32,84 32,80 Z"
        android:fillColor="#F4F5F8" />

    <!-- Folded top-right corner: darker triangle + outline stroke. -->
    <path
        android:pathData="M64,24 L74,34 L64,34 Z"
        android:fillColor="#D5D9E2" />
    <path
        android:pathData="M64,24 L64,34 L74,34"
        android:strokeColor="#B4BCCD"
        android:strokeWidth="0.7"
        android:strokeLineJoin="round" />

    <!-- Blue name-bar. Primary silhouette read at 48dp. -->
    <path
        android:pathData="M38,42 L62,42 Q64,42 64,44 L64,48 Q64,50 62,50 L38,50 Q36,50 36,48 L36,44 Q36,42 38,42 Z"
        android:fillColor="#3D82F6" />

    <!-- Subtitle line -->
    <path
        android:pathData="M38,54 L54,54 Q55,54 55,55 L55,56 Q55,57 54,57 L38,57 Q37,57 37,56 L37,55 Q37,54 38,54 Z"
        android:fillColor="#9AA4B8" />

    <!-- Body lines -->
    <path
        android:pathData="M38,62 L68,62 Q69,62 69,63 L69,64 Q69,65 68,65 L38,65 Q37,65 37,64 L37,63 Q37,62 38,62 Z"
        android:fillColor="#C9D0DD" />
    <path
        android:pathData="M38,68 L68,68 Q69,68 69,69 L69,70 Q69,71 68,71 L38,71 Q37,71 37,70 L37,69 Q37,68 38,68 Z"
        android:fillColor="#C9D0DD" />
    <path
        android:pathData="M38,74 L60,74 Q61,74 61,75 L61,76 Q61,77 60,77 L38,77 Q37,77 37,76 L37,75 Q37,74 38,74 Z"
        android:fillColor="#C9D0DD" />

    <!-- Section marker down the left edge of the document. -->
    <path
        android:pathData="M32,42 L34,42 L34,54 L32,54 Z"
        android:fillColor="#3D82F6" />
</vector>
